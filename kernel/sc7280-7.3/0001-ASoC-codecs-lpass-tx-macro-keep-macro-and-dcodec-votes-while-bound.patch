From 6dc794506e3d32e380846a3bb63dc686573ded9d Mon Sep 17 00:00:00 2001
From: "D.R.racer" <drracer@seznam.cz>
Date: Sat, 14 Nov 2026 17:08:23 +0100
Subject: [PATCH] ASoC: codecs: lpass-tx-macro: keep macro and dcodec votes
 while bound

Since commit b9b23e72abef ("ASoC: codecs: lpass-tx-macro: switch to PM
clock framework for runtime PM") all DT clocks of the TX macro are PM
clocks. Runtime suspend therefore also drops the macro and dcodec votes
(LPASS_HW_MACRO_VOTE, LPASS_HW_DCODEC_VOTE). Before that commit both
were held from probe to remove, and runtime suspend gated only mclk, npl
and fsgen.

Once the macro autosuspends after probe, the DSP releases the LPASS codec
core, and state that regcache_sync() does not restore is lost, most
likely in the SoundWire TX master in the same block. On the Fairphone 5
(QCM6490) microphone capture then returns only zero samples: the PCM
runs and every DAPM widget on the path is on, but no audio comes through.

Take the two votes at probe, outside of the PM clocks, and release them
at remove, as before the conversion. mclk, npl and fsgen stay under
runtime PM.

Fixes: b9b23e72abef ("ASoC: codecs: lpass-tx-macro: switch to PM clock framework for runtime PM")
Assisted-by: LLM
Signed-off-by: D.R.racer <drracer@seznam.cz>
---
 sound/soc/codecs/lpass-tx-macro.c | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/lpass-tx-macro.c b/sound/soc/codecs/lpass-tx-macro.c
index a8e83eb60ba2..1599cb551c2a 100644
--- a/sound/soc/codecs/lpass-tx-macro.c
+++ b/sound/soc/codecs/lpass-tx-macro.c
@@ -2346,6 +2346,19 @@ static int tx_macro_probe(struct platform_device *pdev)
 	if (ret < 0)
 		goto err;
 
+	/*
+	 * Keep the macro and dcodec votes for as long as the driver is bound,
+	 * outside of the PM clocks. Dropping them in runtime suspend lets the
+	 * LPASS codec core power down, which loses state that regcache_sync()
+	 * does not restore, and capture then returns only silence.
+	 */
+	ret = clk_prepare_enable(tx->macro);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = clk_prepare_enable(tx->dcodec);
+	if (ret)
+		goto err_macro;
 
 	/* reset soundwire block */
 	if (tx->data->flags & LPASS_MACRO_FLAG_RESET_SWR)
@@ -2364,11 +2377,11 @@ static int tx_macro_probe(struct platform_device *pdev)
 					      tx_macro_dai,
 					      ARRAY_SIZE(tx_macro_dai));
 	if (ret)
-		goto err_rpm_put;
+		goto err_dcodec;
 
 	ret = tx_macro_register_mclk_output(tx);
 	if (ret)
-		goto err_rpm_put;
+		goto err_dcodec;
 
 	ret = pm_runtime_put_autosuspend(dev);
 	if (ret < 0)
@@ -2376,6 +2389,10 @@ static int tx_macro_probe(struct platform_device *pdev)
 
 	return 0;
 
+err_dcodec:
+	clk_disable_unprepare(tx->dcodec);
+err_macro:
+	clk_disable_unprepare(tx->macro);
 err_rpm_put:
 	if (pm_runtime_put_sync_suspend(dev) < 0)
 		dev_warn(dev, "runtime PM sync suspend failed in probe unwind\n");
@@ -2389,6 +2406,8 @@ static void tx_macro_remove(struct platform_device *pdev)
 {
 	struct tx_macro *tx = dev_get_drvdata(&pdev->dev);
 
+	clk_disable_unprepare(tx->dcodec);
+	clk_disable_unprepare(tx->macro);
 	lpass_macro_pds_exit(tx->pds);
 }
 
-- 
